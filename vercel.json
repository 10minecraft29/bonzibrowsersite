{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/download/",
      "destination": "/download.html"
    },
    {
      "source": "/releases",
      "destination": "/releases.html"
    },
    {
      "source": "/releases/",
      "destination": "/releases.html"
    },
    {
      "source": "/extensions",
      "destination": "/extensions.html"
    },
    {
      "source": "/extensions/",
      "destination": "/extensions.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/",
      "destination": "/support.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    }
  ]
}
